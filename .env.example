# Nothing here is required for local development (`npm run dev` stores data in .data/).

# Production (set in Vercel as sensitive variables):
# DATABASE_URL=postgres://xmas_app.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
# SESSION_SECRET=<long random string>

# Optional overrides
# SITE_PASSWORD=<a new password>
# SITE_PASSWORD_HASH=<output of: npm run hash-password -- 'a new password'>
# ORDER_DEADLINE=2026-12-08T23:59:59Z
# PARTY_SIZE=12
# MAX_GUESTS=18
