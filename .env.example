# Nothing here is required for local development (`npm run dev`).
# On Vercel, connecting "Upstash for Redis" sets the KV_* variables for you.

# KV_REST_API_URL=https://<your-db>.upstash.io
# KV_REST_API_TOKEN=<token>

# Optional overrides
# SITE_PASSWORD=<a new password>
# SITE_PASSWORD_HASH=<output of: npm run hash-password -- 'a new password'>
# SESSION_SECRET=<any long random string>
# ORDER_DEADLINE=2026-12-08T23:59:59Z
# PARTY_SIZE=12
# MAX_GUESTS=18
